# Без BACKEND_API_URL все маршруты продолжают работать на моках.
# При включении C# API курсы читаются из PostgreSQL; остальные разделы пока на моках.
# Серверная переменная: не добавлять NEXT_PUBLIC_ и не включать /api в адрес.
# BACKEND_API_URL=http://127.0.0.1:8080

# Демонстрационный пароль PostgreSQL для Docker Compose, не для production.
POSTGRES_PASSWORD=helios_local_only
