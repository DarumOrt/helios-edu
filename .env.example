# Без BACKEND_API_URL все маршруты продолжают работать на моках.
# При включении C# API доступны вход, серверные роли, курсы и пользователи из PostgreSQL.
# Остальные разделы хранят данные в моках, но проверяют сессию и права.
# Серверная переменная: не добавлять NEXT_PUBLIC_ и не включать /api в адрес.
# BACKEND_API_URL=http://127.0.0.1:8080

# Переключатель «Демо / Сервер» в шапке и на странице входа. С BACKEND_API_URL по умолчанию — сервер.
# off — запретить демо-режим (для рабочего развёртывания).
# DEMO_MODE=off

# Демонстрационный пароль PostgreSQL для Docker Compose, не для production.
POSTGRES_PASSWORD=helios_local_only

# Только для локальных демонстрационных аккаунтов; применяется при их создании.
DEMO_PASSWORD=HeliosDemo2026!

# Хранилище файлов (SeaweedFS, S3). Ключи — только для локального запуска.
STORAGE_ACCESS_KEY=helios_local_only
STORAGE_SECRET_KEY=helios_local_only_secret
# Адрес хранилища, который видит браузер (временные ссылки на загрузку и просмотр).
# STORAGE_PUBLIC_URL=http://127.0.0.1:8333
# Сайты, с которых браузер загружает файлы напрямую в хранилище (через запятую).
# STORAGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
