# Образец настроек рабочего сервера. На сервере: скопировать в /opt/heliosedu/.env и заполнить.
# Файл .env в git не попадает. Инструкция — docs/deploy.md.

# Адрес сайта и адрес файлов (два разных имени одного домена, оба должны указывать на сервер).
SITE_URL=https://heliosedu.ru
FILES_URL=https://files.heliosedu.ru

# Пароли придумывает сервер, а не человек: каждое значение — отдельный вывод команды  openssl rand -hex 24
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Первый администратор. Создаётся при первом запуске, пока в базе нет ни одного администратора.
# Пароль временный (не короче 8 символов, буквы и цифра): при первом входе сайт попросит его сменить.
# После первого входа обе строки можно стереть.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Обычно не нужно ---
# Копии: куда складывать и сколько дней хранить на сервере
# BACKUP_DIR=/var/backups/heliosedu
# BACKUP_KEEP_DAYS=14
# Команда, которая уносит готовую копию с сервера (получает путь к папке копии), например скрипт с rclone
# BACKUP_UPLOAD_CMD=
# Сервер за собственным Nginx организации (docs/deploy.md → «За Nginx организации»)
# CADDY_SITE_ADDRESS=http://lms.example.org
# CADDY_FILES_ADDRESS=http://files.lms.example.org
# HTTP_BIND=127.0.0.1:8081
# HTTPS_BIND=127.0.0.1:8444
# TRUSTED_PROXIES=private_ranges
