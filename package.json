{
  "name": "helios-edu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "api:types": "node scripts/api-types.mjs",
    "test:backend": "bash scripts/test-backend.sh"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0"
}
